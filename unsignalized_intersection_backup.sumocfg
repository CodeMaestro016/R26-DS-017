<?xml version="1.0" encoding="UTF-8"?>
<!-- 
SUMO Configuration File: Unsignalized Intersection Simulation
This configuration ties together the network, routes, and simulation settings
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <!-- Input files -->
    <input>
        <!-- Network file containing the intersection layout -->
        <net-file value="networks/unsignalized_intersection.net.xml"/>
        
        <!-- Route file containing vehicle definitions and paths -->
        <route-files value="routes/two_vehicle_routes.rou.xml"/>
    </input>

    <!-- Output files -->
    <output>
        <!-- Write simulation output to outputs directory -->
        <output-file value="outputs/simulation_output.xml"/>
        
        <!-- Generate trip information output -->
        <tripinfo-output value="outputs/tripinfo_output.xml"/>
    </output>

    <!-- Time settings -->
    <time>
        <!-- Simulation end time (in seconds) -->
        <end value="60.0"/>
        
        <!-- Time step length (default is 0.1s) -->
        <step-length value="0.1"/>
    </time>

    <!-- Processing settings -->
    <processing>
        <!-- Enable collision checking for safety -->
        <collision.check-junctions value="true"/>
        
        <!-- Enable junction model for realistic intersection behavior -->
        <junction-model value="junction"/>
    </processing>

    <!-- TraCI settings (for Python control) -->
    <traci_server>
        <!-- Port for TraCI connection -->
        <remote-port value="8813"/>
    </traci_server>

    <!-- GUI settings (for sumo-gui) -->
    <gui_only>
        <!-- Start with zoom level to see the entire intersection -->
        <zoom value="100"/>
        
        <!-- Center view on intersection -->
        <offset value="0,0"/>
    </gui_only>

</configuration>
