<?xml version="1.0" encoding="UTF-8"?>
<!-- 
SUMO Configuration File: Unsignalized Intersection Simulation
Minimal configuration for SUMO 1.26.0 compatibility
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <!-- Input files -->
    <input>
        <!-- Network file containing the intersection layout -->
        <net-file value="networks/unsignalized_intersection.net.xml"/>
        
        <!-- Route file containing vehicle definitions and paths -->
        <route-files value="routes/two_vehicle_routes.rou.xml"/>
    </input>

    <!-- Time settings -->
    <time>
        <!-- Simulation end time (in seconds) -->
        <end value="60.0"/>
        
        <!-- Time step length (default is 0.1s) -->
        <step-length value="0.1"/>
    </time>

    <!-- TraCI settings (for Python control) -->
    <traci_server>
        <!-- Port for TraCI connection -->
        <remote-port value="8813"/>
    </traci_server>

</configuration>
