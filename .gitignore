# R26-DS-017 Research Project

# Ignore everything at repository root
/*

# Allow gitignore itself
!/.gitignore

# Allow ONLY these four folders
!/component_1/
!/component_2_right_of_way_negotiation/
!/component_3/
!/socialmind_drive_showcase/

# Python caches
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.pyc
**/*.pyo

# Virtual environments
**/.venv/
**/venv/
**/node_modules/

# Temporary files
**/*.log
**/Thumbs.db
**/.DS_Store

# Secrets
**/.env
**/.env.*
!**/.env.example

# IDE folders
**/.vscode/
**/.idea/

# Large generated Component 2 results
/component_2_right_of_way_negotiation/results/*

# Preserve selected MAPPO artifacts
!/component_2_right_of_way_negotiation/results/final_mappo_selection_v2/
