# ============================================================
# ADAPTIVE INTENT PREDICTION - PROJECT-SPECIFIC IGNORES
# ============================================================

# ------------------------------------------------------------
# DATASETS
# Do NOT push PIE raw videos, extracted frames, annotations,
# generated training datasets, or other large local data.
# ------------------------------------------------------------
datasets/
data/

# ------------------------------------------------------------
# CARLA LOCAL INSTALLATION / GENERATED FILES
# Keep CARLA integration scripts in scripts/carla/ if present,
# but do not push the simulator installation itself.
# ------------------------------------------------------------
CARLA*/
CarlaUE4/
carla_dist/
carla_install/

# ------------------------------------------------------------
# GENERIC TRAINING / CACHE DIRECTORIES
# ------------------------------------------------------------
runs/
logs/
cache/
checkpoints/

# ------------------------------------------------------------
# GENERATED MEDIA / INTERMEDIATE NUMERICAL FILES
# These are not needed for runtime deployment.
# ------------------------------------------------------------
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.png
outputs/**/*.bmp
outputs/**/*.gif
outputs/**/*.avi
outputs/**/*.mov
outputs/**/*.mp4
outputs/**/*.mkv

outputs/**/*.npy
outputs/**/*.npz

outputs/**/*.csv
outputs/**/*.log

# TensorBoard / training-event files
outputs/**/events.out.tfevents.*

# ------------------------------------------------------------
# EARLY / INTERMEDIATE PHASE OUTPUTS NOT REQUIRED AT RUNTIME
# ------------------------------------------------------------
outputs/phase2/
outputs/phase3/

# ------------------------------------------------------------
# PHASE 9 GENERATED DEMO / DIAGNOSTIC OUTPUTS
# ------------------------------------------------------------
outputs/phase9/full_automatic_runtime/
outputs/phase9/final_raw_video_demo/
outputs/phase9/external_video_demo/
outputs/phase9/probabilistic_runtime_integration/

# ------------------------------------------------------------
# OLD / INTERMEDIATE YOLO TRAINING RUNS
# Keep only the final V2 runtime checkpoint manually.
# ------------------------------------------------------------
outputs/phase9/yolo_pedestrian/yolo11n_pie_occlusion_v1*/
outputs/phase9/yolo_pedestrian/**/weights/last.pt

# Ultralytics visual/training artifacts
outputs/phase9/yolo_pedestrian/**/train_batch*.jpg
outputs/phase9/yolo_pedestrian/**/val_batch*.jpg
outputs/phase9/yolo_pedestrian/**/labels*.jpg
outputs/phase9/yolo_pedestrian/**/results.png
outputs/phase9/yolo_pedestrian/**/confusion_matrix*.png
outputs/phase9/yolo_pedestrian/**/*_curve.png

# ------------------------------------------------------------
# ARCHIVES / LARGE TEMP PACKAGES
# ------------------------------------------------------------
*.zip
*.rar
*.7z

# Generic pretrained YOLO weights in project root
/yolo11n.pt
/yolo11s.pt
/yolo26n.pt
/notebooks/
# Research notebooks not needed for deployment
/notebooks/

