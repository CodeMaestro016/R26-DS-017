<?xml version="1.0" encoding="UTF-8"?>
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    <!-- Vehicle road -->
    <edge id="road1" from="start"     to="crosswalk" numLanes="1" speed="13.89" priority="2"/>
    <edge id="road2" from="crosswalk" to="end"        numLanes="1" speed="13.89" priority="2"/>

    <!-- Pedestrian sidewalk (south side) -->
    <edge id="walk1" from="start"     to="crosswalk" numLanes="1" speed="1.5" priority="-1" allow="pedestrian"/>
    <edge id="walk2" from="crosswalk" to="end"        numLanes="1" speed="1.5" priority="-1" allow="pedestrian"/>
</edges>
