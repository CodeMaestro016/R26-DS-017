<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Pedestrian type -->
    <vType id="pedestrian_type" vClass="pedestrian" width="0.5" length="0.5" maxSpeed="1.5" guiShape="pedestrian"/>

    <!-- Pedestrian:
         t=2s  : appears at start of walkway
         walks to x=95 (just before crosswalk)
         stops for 8 seconds (Waiting state)
         then crosses (Committed state)
    -->
    <person id="pedestrian_0" type="pedestrian_type" depart="2" color="1,0,0">
        <walk edges="walk1" arrivalPos="95"/>
        <stop duration="8"/>
        <walk edges="walk1 walk2" arrivalPos="50"/>
    </person>

</routes>
