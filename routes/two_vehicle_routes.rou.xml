<?xml version="1.0" encoding="UTF-8"?>
<!-- 
SUMO Route File: Two Vehicle Scenario
Vehicle A: West to East (priority/assertive vehicle)
Vehicle B: South to North (yielding vehicle)
Both vehicles arrive near intersection at similar time
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- Vehicle type definition - must come before vehicles that use it -->
    <vType id="passenger" accel="2.6" decel="4.5" sigma="0.0" length="5.0" minGap="2.5" maxSpeed="13.9" speedFactor="1.0" speedDev="0.0"/>
    
    <!-- Vehicle A: Starting from West, going East (priority vehicle) -->
    <!-- This vehicle will be the assertive one that gets priority -->
    <vehicle id="vehicle_A" type="passenger" depart="0.0" departLane="0" departPos="0.0" departSpeed="13.9">
        <route edges="W_to_center center_to_E"/>
    </vehicle>
    
    <!-- Vehicle B: Starting from South, going North (yielding vehicle) -->
    <!-- This vehicle will yield to Vehicle A - depart 0.5s later for close arrival -->
    <vehicle id="vehicle_B" type="passenger" depart="0.5" departLane="0" departPos="0.0" departSpeed="13.9">
        <route edges="S_to_center center_to_N"/>
    </vehicle>

</routes>
